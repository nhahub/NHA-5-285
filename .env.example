# Copy to .env and fill in. .env is git-ignored; never commit a real key.
#
# The tool itself never reads this file: it reads the credential from the environment only (FR-1.3a).
# Load it into the environment with uv:
#   uv run --env-file .env agentic-review review
#   uv run --env-file .env python scripts/s1_tool_calling_probe.py --runs 50

# NVIDIA NIM API key (free tier: https://build.nvidia.com). Required for any review that reaches the model.
AGENTIC_REVIEW_API_KEY=



LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
# Set host URL: Cloud US/EU or local host
LANGFUSE_BASE_URL="https://cloud.langfuse.com" # Or "http://localhost:3000" if self-hosted
